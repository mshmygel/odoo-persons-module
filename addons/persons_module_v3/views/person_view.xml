<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Tree view for listing person records in a tabular format.
        Displays first name, last name, full name, age, sex, and company.
    -->
    <record id="view_person_tree" model="ir.ui.view">
        <field name="name">person.tree</field>
        <field name="model">persons.person</field>
        <field name="arch" type="xml">
            <tree>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="full_name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!--
        Form view for creating and editing person records.
        Computed fields (full_name, age) are readonly.
    -->
    <record id="view_person_form" model="ir.ui.view">
        <field name="name">person.form</field>
        <field name="model">persons.person</field>
        <field name="arch" type="xml">
            <form string="Person">
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="full_name" readonly="1"/>
                        <field name="birthday"/>
                        <field name="age" readonly="1"/>
                        <field name="sex"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
